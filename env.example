<button class="ai-fab" id="ai-fab" onclick="toggleAILateral()">◆ AI</button>
<div class="ai-overlay-bg" id="ai-overlay-bg" onclick="closeAILateral()"></div>
<div class="ai-lateral" id="ai-lateral">
  <div class="ailat-head">
    <div class="ailat-head-title">◆ Narratore · Superrisponditore</div>
    <div class="ailat-head-ctx" id="ailat-ctx-label">Contesto attivo</div>
    <button class="ailat-close" onclick="closeAILateral()">✕</button>
  </div>
  <div class="ailat-pipeline">
    <div class="ailat-step" id="ailat-step-1"><div class="ailat-step-dot"></div>Narratore</div>
    <div class="ailat-arrow">›</div>
    <div class="ailat-step" id="ailat-step-2"><div class="ailat-step-dot"></div>Domanda</div>
    <div class="ailat-arrow">›</div>
    <div class="ailat-step" id="ailat-step-3"><div class="ailat-step-dot"></div>Superrisponditore</div>
  </div>
  <div class="ailat-body" id="ailat-body">
    <div style="text-align:center;padding:2.5rem 1rem;color:#8888aa;font-size:0.63rem;line-height:2">
      Il Narratore legge il contesto attivo,<br>
      formula la domanda più penetrante<br>
      e la passa al Superrisponditore.<br><br>
      <button onclick="avviaDialogo()" style="background:#5b3d8f;color:#fff;border:none;border-radius:4px;padding:0.65rem 1.5rem;font-family:'IBM Plex Mono',monospace;font-size:0.6rem;text-transform:uppercase;letter-spacing:0.14em;cursor:pointer;box-shadow:0 2px 8px rgba(91,61,143,0.3)">▶ Avvia</button>
    </div>
  </div>
  <div class="ailat-user-input">
    <div class="ailat-input-label">Oppure inserisci la tua domanda</div>
    <div class="ailat-input-row">
      <input class="ailat-input" id="ailat-input" type="text" placeholder="La tua domanda specifica..." onkeydown="if(event.key==='Enter'){inviaUserQuestion();}">
      <button class="ailat-send" onclick="inviaUserQuestion()">▶ Chiedi</button>
    </div>
    <button class="ailat-reset" onclick="resetDialogo()">↺ Ricomincia</button>
  </div>
</div>

<script id="ai-lateral-js">
(function(){
  let _open = false;

  window.toggleAILateral = function(){_open ? closeAILateral() : openAILateral();};

  window.openAILateral = function(){
    _open = true;
    document.getElementById('ai-lateral').classList.add('on');
    document.getElementById('ai-overlay-bg').classList.add('on');
    document.getElementById('ai-fab').classList.add('open-state');
    document.getElementById('ailat-ctx-label').textContent = _ctx().titolo;
  };

  window.closeAILateral = function(){
    _open = false;
    document.getElementById('ai-lateral').classList.remove('on');
    document.getElementById('ai-overlay-bg').classList.remove('on');
    document.getElementById('ai-fab').classList.remove('open-state');
  };

  function _ctx(){
    const av = document.querySelector('.view.active, .tab-content.active, .dtab-content.active');
    const src = av || document;
    const titleEl = src.querySelector('.sec-title,.section-title,.page-title,h1,h2') || document.querySelector('.sec-title,.page-title,h1');
    const titolo = titleEl ? titleEl.textContent.trim() : document.title;
    const rows = [];
    src.querySelectorAll('.kpi-cell,.kpi-item,.sum-card,.bench-item').forEach(el=>{
      const t = [...el.querySelectorAll('*')].filter(n=>!n.children.length&&n.textContent.trim()).map(n=>n.textContent.trim()).filter(t=>t.length<60);
      if(t.length) rows.push(t.join(' · '));
    });
    let tc=0;
    src.querySelectorAll('tr').forEach(row=>{
      if(tc>20) return;
      if(row.classList.contains('sp')||row.classList.contains('spacer')) return;
      const cells=[...row.querySelectorAll('td,th')].map(c=>c.textContent.trim()).filter(Boolean);
      if(cells.length>1 && cells.some(c=>/[0-9€%]/.test(c))){rows.push(cells.join(' | '));tc++;}
    });
    src.querySelectorAll('.anomaly-title,.alert-msg,.flag-text').forEach(el=>rows.push('[SEGNALE] '+el.textContent.trim().substring(0,100)));
    src.querySelectorAll('.rating-letter,.rating-pill,.score-circle,.gauge-circle').forEach(el=>rows.push('[SCORE] '+el.textContent.trim()));
    return {titolo, dati: rows.slice(0,60).join('\n')};
  }

  window.avviaDialogo = function(){
    document.getElementById('ailat-body').innerHTML='';
    _setStep(1);
    _narra();
  };

  async function _narra(){
    const ctx = _ctx();
    const body = document.getElementById('ailat-body');
    const b = _addBlock(body,'narr','◆ Narratore — Lettura del contesto',ctx.titolo,'loading','Sto leggendo il contesto');
    const prompt = 'Sei il Narratore — analista finanziario senior 30 anni esperienza.\nSchermata: "'+ctx.titolo+'"\n\nDATI:\n'+(ctx.dati||'—')+'\n\nDUE PARTI:\n\nPARTE 1 — NARRAZIONE (max 120 parole): Racconta in modo vivido quello che vedi. Non ripetere i numeri — interpretali. Cosa sta succedendo davvero? Parla come un analista che conosce il settore.\n\nPARTE 2: scrivi [DOMANDA] poi LA domanda più penetrante che un CFO farebbe su questo contesto. Precisa, non generica. Tocca il punto critico che i numeri suggeriscono ma non dicono.';
    try{
      const r = await _api(prompt);
      const parts = r.split('[DOMANDA]');
      b.querySelector('.ailat-block-content').classList.remove('loading');
      b.querySelector('.ailat-block-content').textContent = parts[0].trim();
      _setStep(2);
      if(parts[1]){
        await _wait(500);
        const domanda = parts[1].trim();
        _addBlock(body,'dom','◈ Domanda del Narratore','','',domanda);
        await _wait(700);
        _setStep(3);
        await _super(domanda, ctx, body);
      }
    }catch(e){
      b.querySelector('.ailat-block-content').classList.remove('loading');
      b.querySelector('.ailat-block-content').style.color='#c0392b';
      b.querySelector('.ailat-block-content').textContent='Errore: '+e.message;
    }
  }

  async function _super(domanda, ctx, body){
    const b = _addBlock(body,'risp','◆ Superrisponditore','','loading','Sto formulando la risposta');
    const prompt = 'Sei il Superrisponditore — CFO con 25 anni su PMI italiane. Risposte che cambiano decisioni.\n\nCONTESTO: '+ctx.titolo+'\nDATI: '+ctx.dati.substring(0,2000)+'\n\nDOMANDA:\n'+domanda+'\n\nRispondi con massima profondità qualitativa. Non ripetere i numeri. Vai al cuore. Cause non evidenti, implicazioni future, decisioni concrete. Tono da advisor al CDA: diretto, autorevole, preciso. Max 250 parole. Ogni frase aggiunge valore reale.';
    try{
      const r = await _api(prompt);
      b.querySelector('.ailat-block-content').classList.remove('loading');
      b.querySelector('.ailat-block-content').textContent = r;
      b.querySelector('.ailat-block-label span:last-child').textContent = '✓ Completato';
      _setStep(3,true);
      document.getElementById('ailat-body').scrollTop = 99999;
    }catch(e){
      b.querySelector('.ailat-block-content').classList.remove('loading');
      b.querySelector('.ailat-block-content').style.color='#c0392b';
      b.querySelector('.ailat-block-content').textContent='Errore: '+e.message;
    }
  }

  window.inviaUserQuestion = function(){
    const inp = document.getElementById('ailat-input');
    const q = inp.value.trim();
    if(!q) return;
    inp.value='';
    const body = document.getElementById('ailat-body');
    const ctx = _ctx();
    _addBlock(body,'user-q','👤 La tua domanda','','',q);
    _setStep(3);
    _super(q, ctx, body);
  };

  window.resetDialogo = function(){
    document.getElementById('ailat-body').innerHTML='<div style="text-align:center;padding:2.5rem 1rem;color:#8888aa;font-size:0.63rem;line-height:2">Il Narratore legge il contesto attivo,<br>formula la domanda più penetrante<br>e la passa al Superrisponditore.<br><br><button onclick="avviaDialogo()" style="background:#5b3d8f;color:#fff;border:none;border-radius:4px;padding:0.65rem 1.5rem;font-family:IBM Plex Mono,monospace;font-size:0.6rem;text-transform:uppercase;letter-spacing:0.14em;cursor:pointer">▶ Avvia</button></div>';
    [1,2,3].forEach(n=>{const el=document.getElementById('ailat-step-'+n);if(el){el.classList.remove('active','done');}});
  };

  function _addBlock(body,cls,labelL,labelR,contentCls,contentTxt){
    const d=document.createElement('div');
    d.className='ailat-block '+cls;
    d.innerHTML='<div class="ailat-block-label"><span>'+labelL+'</span><span style="color:#8888aa;font-weight:400">'+labelR+'</span></div><div class="ailat-block-content '+(contentCls||'')+'">'+contentTxt+'</div>';
    body.appendChild(d);
    body.scrollTop=99999;
    return d;
  }

  function _setStep(n,done){
    for(let i=1;i<=3;i++){
      const el=document.getElementById('ailat-step-'+i);
      if(!el) continue;
      el.classList.remove('active','done');
      if(i<n) el.classList.add('done');
      else if(i===n&&!done) el.classList.add('active');
      else if(i===n&&done) el.classList.add('done');
    }
  }

  async function _api(prompt){
    const r=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:4000,messages:[{role:'user',content:prompt}]})
    });
    const d=await r.json();
    return d.content?.[0]?.text||'Nessuna risposta.';
  }

  function _wait(ms){return new Promise(r=>setTimeout(r,ms));}
})();
</script>
</body>
</html>
