<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Piattaforma Intelligence Finanziaria</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f4f5f9;
  --surface: #ffffff;
  --surface2: #eef0f7;
  --border: #dde0ee;
  --border2: #c8cce0;
  --viola: #5b3d8f;
  --viola-light: #9b7fd4;
  --viola-dim: #3d2860;
  --viola-bg: #f0ebfa;
  --red: #c0392b;
  --red-bg: #fdf0ef;
  --green: #1e8449;
  --green-bg: #edfaf3;
  --amber: #d35400;
  --amber-bg: #fef6ee;
  --text: #1a1a2e;
  --text2: #4a4a6a;
  --text3: #8888aa;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  line-height: 1.6;
}

/* ── TOPBAR ── */
.topbar {
  background: var(--viola);
  color: #fff;
  padding: 0 2rem;
  display: flex;
  align-items: center;
  gap: 2rem;
  height: 52px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(91,61,143,0.3);
}

.topbar-brand {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.1rem;
  font-weight: 400;
  letter-spacing: 0.05em;
  white-space: nowrap;
}

.topbar-nav {
  display: flex;
  gap: 0;
  flex: 1;
  height: 100%;
}

.nav-btn {
  height: 100%;
  padding: 0 1.2rem;
  background: none;
  border: none;
  color: rgba(255,255,255,0.65);
  cursor: pointer;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  border-bottom: 3px solid transparent;
  transition: all 0.2s;
  white-space: nowrap;
}

.nav-btn:hover { color: #fff; background: rgba(255,255,255,0.08); }
.nav-btn.active { color: #fff; border-bottom-color: #fff; }

.topbar-meta {
  font-size: 0.6rem;
  color: rgba(255,255,255,0.5);
  text-align: right;
  white-space: nowrap;
}

/* ── VIEWS ── */
.view { display: none; padding: 1.5rem 2rem; }
.view.active { display: block; }

/* ── PORTAFOGLIO ── */
.portfolio-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.page-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.4rem;
  color: var(--viola);
}

.page-sub { font-size: 0.6rem; color: var(--text3); margin-top: 0.2rem; }

.btn {
  padding: 0.55rem 1.2rem;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
  border-radius: 3px;
}

.btn-viola { background: var(--viola); color: #fff; }
.btn-viola:hover { background: var(--viola-dim); }
.btn-viola:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-ghost { background: #fff; color: var(--text2); border: 1px solid var(--border2); }
.btn-ghost:hover { border-color: var(--viola-light); color: var(--viola); }

/* Summary cards */
.summary-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.sum-card {
  background: #fff;
  border: 1px solid var(--border);
  padding: 1rem 1.2rem;
  border-radius: 6px;
}

.sum-label { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text3); margin-bottom: 0.4rem; }
.sum-val { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; color: var(--viola); }
.sum-sub { font-size: 0.6rem; color: var(--text3); margin-top: 0.2rem; }

/* Company cards */
.company-grid {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.company-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1rem 1.2rem;
  display: grid;
  grid-template-columns: 3px 200px 1fr repeat(5,80px) 120px 100px;
  gap: 1rem;
  align-items: center;
  cursor: pointer;
  transition: all 0.2s;
}

.company-card:hover { border-color: var(--viola-light); box-shadow: 0 2px 12px rgba(91,61,143,0.1); }

.card-stripe { align-self: stretch; border-radius: 2px; }
.stripe-A { background: var(--green); }
.stripe-B { background: var(--viola-light); }
.stripe-C { background: var(--amber); }
.stripe-D { background: var(--red); }

.card-name { font-size: 0.75rem; font-weight: 500; }
.card-sector { font-size: 0.6rem; color: var(--text3); margin-top: 0.15rem; }

.card-kpi { text-align: right; }
.card-kpi-label { font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text3); }
.card-kpi-val { font-size: 0.75rem; font-weight: 500; margin-top: 0.1rem; }

.rating-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px; height: 28px;
  border-radius: 50%;
  font-family: 'Cormorant Garamond', serif;
  font-size: 1rem;
  font-weight: 600;
}

.pill-A { background: var(--green-bg); color: var(--green); border: 2px solid var(--green); }
.pill-B { background: var(--viola-bg); color: var(--viola); border: 2px solid var(--viola-light); }
.pill-C { background: var(--amber-bg); color: var(--amber); border: 2px solid var(--amber); }
.pill-D { background: var(--red-bg); color: var(--red); border: 2px solid var(--red); }

.score-col { text-align: center; }
.score-circle {
  width: 44px; height: 44px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.75rem; font-weight: 600;
  margin: 0 auto;
}

.card-actions { display: flex; gap: 0.4rem; justify-content: flex-end; }

/* Alert badges */
.alert-badge {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  font-size: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-radius: 2px;
  font-weight: 600;
}

.badge-critical { background: var(--red-bg); color: var(--red); border: 1px solid #e8c0bc; }
.badge-warn { background: var(--amber-bg); color: var(--amber); border: 1px solid #f0d4bc; }
.badge-ok { background: var(--green-bg); color: var(--green); border: 1px solid #b8e8cc; }

/* ── DETAIL VIEW ── */
.detail-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border);
}

.back-btn {
  background: none; border: none; cursor: pointer;
  color: var(--viola); font-size: 0.65rem;
  font-family: 'IBM Plex Mono', monospace;
  text-transform: uppercase; letter-spacing: 0.1em;
  padding: 0.3rem 0.6rem;
  border: 1px solid var(--border2);
  border-radius: 3px;
}

.back-btn:hover { background: var(--viola-bg); }

.detail-tabs {
  display: flex;
  border-bottom: 2px solid var(--border);
  margin-bottom: 1.5rem;
}

.dtab {
  padding: 0.6rem 1.2rem;
  background: none; border: none;
  cursor: pointer;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--text3);
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
}

.dtab.active { color: var(--viola); border-bottom-color: var(--viola); font-weight: 600; }
.dtab:hover:not(.active) { color: var(--text2); }

.dtab-content { display: none; }
.dtab-content.active { display: block; }

/* KPI grid */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin-bottom: 1.5rem;
  border-radius: 6px;
  overflow: hidden;
}

.kpi-cell {
  background: #fff;
  padding: 1rem 1.2rem;
}

.kpi-label { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text3); margin-bottom: 0.3rem; }
.kpi-val { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 400; }
.kpi-delta { font-size: 0.6rem; margin-top: 0.15rem; }
.up { color: var(--green); }
.down { color: var(--red); }
.warn { color: var(--amber); }

/* Charts */
.charts-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }

.chart-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1rem;
}

.chart-title { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text3); margin-bottom: 1rem; }

.bars { display: flex; align-items: flex-end; gap: 4px; height: 70px; }

.bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }

.bar {
  width: 100%;
  border-radius: 2px 2px 0 0;
  transition: height 0.8s ease;
  min-height: 2px;
}

.bar-lbl { font-size: 0.5rem; color: var(--text3); }

/* Data table */
.data-tbl {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.65rem;
  background: #fff;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--border);
  margin-bottom: 1.5rem;
}

.data-tbl th {
  padding: 0.6rem 0.8rem;
  background: #f8f6fd;
  color: var(--viola);
  font-size: 0.55rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
  border-bottom: 2px solid var(--border);
  text-align: right;
}

.data-tbl th:first-child { text-align: left; }
.data-tbl td { padding: 0.5rem 0.8rem; border-bottom: 1px solid var(--border); text-align: right; color: var(--text2); }
.data-tbl td:first-child { text-align: left; color: var(--text3); font-size: 0.55rem; text-transform: uppercase; }
.data-tbl tr:hover td { background: var(--viola-bg); }
.pos { color: var(--green) !important; font-weight: 500; }
.neg { color: var(--red) !important; font-weight: 500; }

/* ── STRESS TEST ── */
.stress-layout { display: grid; grid-template-columns: 300px 1fr; gap: 1.5rem; }

.stress-controls {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1.2rem;
}

.stress-title { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--viola); font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border); }

.slider-group { margin-bottom: 1.2rem; }
.slider-label { display: flex; justify-content: space-between; font-size: 0.6rem; color: var(--text2); margin-bottom: 0.4rem; }
.slider-val { color: var(--viola); font-weight: 600; }

input[type=range] {
  width: 100%; height: 4px;
  -webkit-appearance: none;
  background: var(--border2);
  border-radius: 2px;
  outline: none;
}

input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 14px; height: 14px;
  border-radius: 50%;
  background: var(--viola);
  cursor: pointer;
}

.stress-results { display: flex; flex-direction: column; gap: 1rem; }

.stress-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1rem;
}

.stress-company { font-size: 0.65rem; font-weight: 600; margin-bottom: 0.8rem; color: var(--viola); }

.stress-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }

.stress-kpi { text-align: center; }
.stress-kpi-label { font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text3); margin-bottom: 0.2rem; }
.stress-kpi-base { font-size: 0.65rem; color: var(--text3); text-decoration: line-through; }
.stress-kpi-new { font-size: 0.85rem; font-weight: 600; }

.stress-verdict {
  margin-top: 0.8rem;
  padding: 0.6rem 0.8rem;
  border-radius: 3px;
  font-size: 0.65rem;
  font-weight: 600;
}

.verdict-ok { background: var(--green-bg); color: var(--green); }
.verdict-warn { background: var(--amber-bg); color: var(--amber); }
.verdict-critical { background: var(--red-bg); color: var(--red); }

/* ── PREDITTIVO ── */
.pred-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.5rem; }

.pred-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1.2rem;
}

.pred-company { font-size: 0.65rem; font-weight: 600; color: var(--viola); margin-bottom: 1rem; }

.pred-gauge {
  display: flex;
  gap: 1rem;
  align-items: center;
  margin-bottom: 1rem;
}

.gauge-circle {
  width: 70px; height: 70px;
  border-radius: 50%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  flex-shrink: 0;
  border: 4px solid;
}

.gauge-pct { font-size: 1rem; font-weight: 700; line-height: 1; }
.gauge-lbl { font-size: 0.45rem; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.1rem; }

.gauge-miglio { border-color: var(--green); color: var(--green); }
.gauge-stabile { border-color: var(--viola-light); color: var(--viola); }
.gauge-rischio { border-color: var(--amber); color: var(--amber); }
.gauge-critico { border-color: var(--red); color: var(--red); }

.pred-factors { flex: 1; }
.pred-factor { display: flex; justify-content: space-between; font-size: 0.6rem; padding: 0.2rem 0; border-bottom: 1px solid var(--border); color: var(--text2); }
.pred-factor:last-child { border-bottom: none; }
.factor-pos { color: var(--green); font-weight: 600; }
.factor-neg { color: var(--red); font-weight: 600; }
.factor-neu { color: var(--amber); font-weight: 600; }

.pred-narrative {
  font-family: 'Cormorant Garamond', serif;
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--text);
  padding-top: 0.8rem;
  border-top: 1px solid var(--border);
}

/* ── ALERT ── */
.alert-panel {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 1rem;
}

.alert-panel-header {
  background: var(--viola);
  color: #fff;
  padding: 0.7rem 1rem;
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  display: flex;
  justify-content: space-between;
}

.alert-list { }

.alert-item {
  display: grid;
  grid-template-columns: 4px 180px 1fr auto;
  gap: 1rem;
  align-items: center;
  padding: 0.8rem 1rem;
  border-bottom: 1px solid var(--border);
}

.alert-item:last-child { border-bottom: none; }

.alert-bar { align-self: stretch; border-radius: 2px; }
.bar-critical { background: var(--red); }
.bar-warn { background: var(--amber); }
.bar-info { background: var(--viola-light); }

.alert-company { font-size: 0.65rem; font-weight: 600; }
.alert-sector { font-size: 0.55rem; color: var(--text3); }
.alert-msg { font-size: 0.63rem; color: var(--text2); line-height: 1.5; }
.alert-action { font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap; }
.action-critical { color: var(--red); }
.action-warn { color: var(--amber); }

/* ── AI PANEL ── */
.ai-panel {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  margin-top: 1rem;
}

.ai-header {
  background: var(--viola);
  color: #fff;
  padding: 0.7rem 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
}

.ai-body { padding: 1.5rem; min-height: 200px; }

.ai-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1rem;
  line-height: 2;
  color: var(--text);
  white-space: pre-wrap;
}

.loading { color: var(--text3); font-size: 0.7rem; }
.loading::after { content: ''; animation: dots 1.5s infinite; }
@keyframes dots { 0%{content:''} 33%{content:'.'} 66%{content:'..'} 100%{content:'...'} }

/* ── REPORT ── */
.report-layout { display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem; }

.report-sidebar {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1.2rem;
}

.report-option {
  display: flex;
  gap: 0.8rem;
  align-items: flex-start;
  padding: 0.8rem;
  border: 1px solid var(--border);
  border-radius: 4px;
  margin-bottom: 0.6rem;
  cursor: pointer;
  transition: all 0.2s;
}

.report-option:hover { border-color: var(--viola-light); background: var(--viola-bg); }
.report-option.selected { border-color: var(--viola); background: var(--viola-bg); }

.report-option-icon { font-size: 1.2rem; flex-shrink: 0; }
.report-option-title { font-size: 0.65rem; font-weight: 600; margin-bottom: 0.15rem; }
.report-option-desc { font-size: 0.55rem; color: var(--text3); line-height: 1.4; }

.report-preview {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 1.5rem;
}

.report-preview-inner {
  font-family: 'Cormorant Garamond', serif;
  font-size: 0.95rem;
  line-height: 2;
  color: var(--text);
  white-space: pre-wrap;
  min-height: 400px;
}

/* Scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--viola-light); border-radius: 2px; }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-brand">◆ Intelligence Finanziaria</div>
  <nav class="topbar-nav">
    <button class="nav-btn active" onclick="showView('portafoglio')">① Portafoglio</button>
    <button class="nav-btn" onclick="showView('predittivo')">② Predittivo 12 Mesi</button>
    <button class="nav-btn" onclick="showView('stress')">③ Simulatore Stress</button>
    <button class="nav-btn" onclick="showView('alert')">④ Alert Precursori</button>
    <button class="nav-btn" onclick="showView('report')">⑤ Lettera Due Diligence</button>
  </nav>
  <div class="topbar-meta">
    <div id="topbar-date"></div>
    <div style="color:rgba(255,255,255,0.4)">Riservato · Uso Interno</div>
  </div>
</div>

<!-- ①  PORTAFOGLIO -->
<div id="view-portafoglio" class="view active">
  <div class="portfolio-header">
    <div>
      <div class="page-title">Portafoglio Clienti</div>
      <div class="page-sub">Ordine per punteggio di rischio proprietario · Aggiornato ai dati CreditSafe</div>
    </div>
    <div style="display:flex;gap:0.6rem;align-items:center">
      <label class="btn btn-ghost" style="cursor:pointer">
        ＋ Carica JSON
        <input type="file" accept=".json" multiple style="display:none" onchange="loadJSONFiles(this)">
      </label>
    </div>
  </div>

  <div class="summary-row" id="summary-row"></div>
  <div class="company-grid" id="company-grid"></div>
</div>

<!-- DETAIL -->
<div id="view-detail" class="view">
  <div class="detail-header">
    <button class="back-btn" onclick="showView('portafoglio')">← Portafoglio</button>
    <div>
      <div class="page-title" id="detail-title"></div>
      <div class="page-sub" id="detail-sub"></div>
    </div>
  </div>

  <div class="detail-tabs">
    <button class="dtab active" onclick="setDTab('panoramica')">Panoramica</button>
    <button class="dtab" onclick="setDTab('dati')">Dati Storici</button>
    <button class="dtab" onclick="setDTab('anomalie')">Anomalie</button>
    <button class="dtab" onclick="setDTab('analisi')">Analisi AI</button>
  </div>

  <div id="dtab-panoramica" class="dtab-content active"></div>
  <div id="dtab-dati" class="dtab-content"></div>
  <div id="dtab-anomalie" class="dtab-content"></div>
  <div id="dtab-analisi" class="dtab-content"></div>
</div>

<!-- ② PREDITTIVO -->
<div id="view-predittivo" class="view">
  <div class="portfolio-header">
    <div>
      <div class="page-title">Predittivo 12 Mesi</div>
      <div class="page-sub">Probabilità di evoluzione del rating basata sui trend storici · Pattern di deterioramento precoce</div>
    </div>
    <button class="btn btn-viola" onclick="runPredittivo()">◆ Aggiorna Previsioni</button>
  </div>
  <div class="pred-grid" id="pred-grid"></div>
</div>

<!-- ③ STRESS TEST -->
<div id="view-stress" class="view">
  <div class="portfolio-header">
    <div>
      <div class="page-title">Simulatore di Pressione</div>
      <div class="page-sub">Impatto di scenari avversi sui KPI finanziari · Calcolo in tempo reale</div>
    </div>
  </div>

  <div class="stress-layout">
    <div class="stress-controls">
      <div class="stress-title">Parametri dello Scenario</div>

      <div class="slider-group">
        <div class="slider-label">
          <span>Calo fatturato</span>
          <span class="slider-val" id="sv-fatturato">-10%</span>
        </div>
        <input type="range" min="0" max="50" value="10" id="sl-fatturato" oninput="updateStress()">
      </div>

      <div class="slider-group">
        <div class="slider-label">
          <span>Aumento tassi interesse</span>
          <span class="slider-val" id="sv-tassi">+1%</span>
        </div>
        <input type="range" min="0" max="5" step="0.5" value="1" id="sl-tassi" oninput="updateStress()">
      </div>

      <div class="slider-group">
        <div class="slider-label">
          <span>Mancato incasso clienti</span>
          <span class="slider-val" id="sv-incasso">5%</span>
        </div>
        <input type="range" min="0" max="30" value="5" id="sl-incasso" oninput="updateStress()">
      </div>

      <div class="slider-group">
        <div class="slider-label">
          <span>Aumento costi operativi</span>
          <span class="slider-val" id="sv-costi">+5%</span>
        </div>
        <input type="range" min="0" max="30" value="5" id="sl-costi" oninput="updateStress()">
      </div>

      <div class="slider-group">
        <div class="slider-label">
          <span>Perdita liquidità</span>
          <span class="slider-val" id="sv-liquidita">-10%</span>
        </div>
        <input type="range" min="0" max="80" value="10" id="sl-liquidita" oninput="updateStress()">
      </div>

      <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border)">
        <div class="stress-title" style="margin-bottom:0.6rem">Scenari Predefiniti</div>
        <div style="display:flex;flex-direction:column;gap:0.4rem">
          <button class="btn btn-ghost" style="width:100%;text-align:left" onclick="setScenario('recessione')">📉 Recessione moderata</button>
          <button class="btn btn-ghost" style="width:100%;text-align:left" onclick="setScenario('crisi_liquidita')">💧 Crisi di liquidità</button>
          <button class="btn btn-ghost" style="width:100%;text-align:left" onclick="setScenario('cliente_insolvente')">⚠ Cliente principale insolvente</button>
          <button class="btn btn-ghost" style="width:100%;text-align:left" onclick="setScenario('tassi_alti')">📈 Tassi ai massimi</button>
        </div>
      </div>
    </div>

    <div class="stress-results" id="stress-results"></div>
  </div>
</div>

<!-- ④ ALERT -->
<div id="view-alert" class="view">
  <div class="portfolio-header">
    <div>
      <div class="page-title">Alert Precursori di Default</div>
      <div class="page-sub">Pattern che precedono il deterioramento finanziario 12-18 mesi prima · Monitoraggio continuo</div>
    </div>
    <button class="btn btn-viola" onclick="runAlertAI()">◆ Analisi AI Approfondita</button>
  </div>

  <div id="alert-panels"></div>
  <div class="ai-panel" id="alert-ai-panel" style="display:none">
    <div class="ai-header">
      <span>◆ Superrisponditore · Analisi Precursori di Default</span>
      <span id="alert-ai-status">In attesa</span>
    </div>
    <div class="ai-body" id="alert-ai-body">
      <div class="loading">Avvia l'analisi per il report completo</div>
    </div>
  </div>
</div>

<!-- ⑤ REPORT -->
<div id="view-report" class="view">
  <div class="portfolio-header">
    <div>
      <div class="page-title">Lettera di Due Diligence</div>
      <div class="page-sub">Documento professionale generato dall'AI · Pronto per il CDA</div>
    </div>
  </div>

  <div class="report-layout">
    <div class="report-sidebar">
      <div class="stress-title">Configurazione</div>

      <div style="margin-bottom:1rem">
        <div class="slider-label" style="margin-bottom:0.4rem"><span style="font-size:0.6rem;color:var(--text2)">Azienda</span></div>
        <select id="report-company" style="width:100%;padding:0.5rem;border:1px solid var(--border2);border-radius:3px;font-family:'IBM Plex Mono',monospace;font-size:0.65rem;color:var(--text)">
        </select>
      </div>

      <div style="margin-bottom:1rem">
        <div class="slider-label" style="margin-bottom:0.4rem"><span style="font-size:0.6rem;color:var(--text2)">Mittente</span></div>
        <input type="text" id="report-mittente" value="Ufficio Commerciale" style="width:100%;padding:0.5rem;border:1px solid var(--border2);border-radius:3px;font-family:'IBM Plex Mono',monospace;font-size:0.65rem">
      </div>

      <div style="margin-bottom:1rem">
        <div class="slider-label" style="margin-bottom:0.4rem"><span style="font-size:0.6rem;color:var(--text2)">Destinatario</span></div>
        <input type="text" id="report-destinatario" value="Direzione Generale" style="width:100%;padding:0.5rem;border:1px solid var(--border2);border-radius:3px;font-family:'IBM Plex Mono',monospace;font-size:0.65rem">
      </div>

      <div style="margin-bottom:1.2rem">
        <div class="slider-label" style="margin-bottom:0.6rem"><span style="font-size:0.6rem;color:var(--text2)">Tipo documento</span></div>
        <div class="report-option selected" id="ropt-full" onclick="selectReport('full')">
          <div class="report-option-icon">📋</div>
          <div><div class="report-option-title">Due Diligence Completa</div><div class="report-option-desc">Analisi approfondita · 6 sezioni · Raccomandazione operativa</div></div>
        </div>
        <div class="report-option" id="ropt-exec" onclick="selectReport('exec')">
          <div class="report-option-icon">⚡</div>
          <div><div class="report-option-title">Executive Summary</div><div class="report-option-desc">Sintesi di 1 pagina · Solo elementi decisionali</div></div>
        </div>
        <div class="report-option" id="ropt-credit" onclick="selectReport('credit')">
          <div class="report-option-icon">💳</div>
          <div><div class="report-option-title">Parere sul Credito</div><div class="report-option-desc">Limite consigliato · Condizioni · Clausole</div></div>
        </div>
      </div>

      <button class="btn btn-viola" style="width:100%" onclick="generateReport()">◆ Genera Documento</button>
    </div>

    <div class="report-preview">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;padding-bottom:0.8rem;border-bottom:1px solid var(--border)">
        <div style="font-size:0.6rem;text-transform:uppercase;letter-spacing:0.15em;color:var(--viola)">◆ Anteprima Documento</div>
        <button class="btn btn-ghost" id="btn-copy" onclick="copyReport()" style="display:none">⎘ Copia testo</button>
      </div>
      <div class="report-preview-inner" id="report-output">
        <span style="color:var(--text3)">Seleziona un'azienda e il tipo di documento, poi clicca Genera.</span>
      </div>
    </div>
  </div>
</div>

<script>
// ── DATI ──────────────────────────────────────────────────────
const PORTFOLIO = [{"id":"BS511031","nome":"RCS TECNOIMPIANTI S.R.L.","settore":"Installazione di impianti elettrici","ateco":"43210","stato":"Attiva","rating":"C","rating_desc":"Rischio Moderato","rating_score":44,"rating_prev":"Rischio Basso","limite_credito":10000,"anni":[{"anno":"2024","fatturato":2503557.0,"ebitda":120644,"ebitda_margin":4.82,"op_margin":3.94,"net_margin":1.75,"utile_operativo":98662.0,"utile_netto":43774.0,"salari":284817.0,"ammortamenti":21982.0,"interessi_passivi":7990.0,"utile_ante_imposte":94155.0,"imposte":50381.0,"totale_attivo":1505072.0,"immobilizzazioni":549417.0,"crediti_clienti":460063.0,"rimanenze":138500.0,"liquidita":198206.0,"patrimonio_netto":265504.0,"debiti_totali":1239568.0,"debiti_breve":0,"roi":12.22,"roe":0,"current_ratio":1.25,"debt_equity":209.01,"dso":67.07,"dpo":36.67},{"anno":"2023","fatturato":2544771.0,"ebitda":165885,"ebitda_margin":6.52,"op_margin":5.53,"net_margin":2.7,"utile_operativo":140733.0,"utile_netto":68614.0,"salari":350013.0,"ammortamenti":25152.0,"interessi_passivi":10234.0,"utile_ante_imposte":131103.0,"imposte":62489.0,"totale_attivo":1740475.0,"immobilizzazioni":486140.0,"crediti_clienti":614654.0,"rimanenze":157715.0,"liquidita":318269.0,"patrimonio_netto":377731.0,"debiti_totali":1362744.0,"debiti_breve":0,"roi":15.01,"roe":0,"current_ratio":1.39,"debt_equity":161.0,"dso":88.16,"dpo":40.27},{"anno":"2022","fatturato":2669090.0,"ebitda":150756,"ebitda_margin":5.65,"op_margin":4.62,"net_margin":3.07,"utile_operativo":123232.0,"utile_netto":82038.0,"salari":340266.0,"ammortamenti":27524.0,"interessi_passivi":5293.0,"utile_ante_imposte":117941.0,"imposte":35903.0,"totale_attivo":1737063.0,"immobilizzazioni":305573.0,"crediti_clienti":690629.0,"rimanenze":169820.0,"liquidita":286770.0,"patrimonio_netto":384117.0,"debiti_totali":1352946.0,"debiti_breve":0,"roi":13.79,"roe":0,"current_ratio":1.56,"debt_equity":161.48,"dso":94.44,"dpo":47.64},{"anno":"2021","fatturato":2195933.0,"ebitda":147769,"ebitda_margin":6.73,"op_margin":5.49,"net_margin":3.32,"utile_operativo":120604.0,"utile_netto":72914.0,"salari":306417.0,"ammortamenti":27165.0,"interessi_passivi":5641.0,"utile_ante_imposte":114965.0,"imposte":42051.0,"totale_attivo":1323285.0,"immobilizzazioni":160474.0,"crediti_clienti":546491.0,"rimanenze":99500.0,"liquidita":278944.0,"patrimonio_netto":302079.0,"debiti_totali":1021206.0,"debiti_breve":0,"roi":16.81,"roe":0,"current_ratio":1.82,"debt_equity":172.22,"dso":90.84,"dpo":56.68},{"anno":"2020","fatturato":1972990.0,"ebitda":80243,"ebitda_margin":4.07,"op_margin":2.97,"net_margin":1.66,"utile_operativo":58528.0,"utile_netto":32810.0,"salari":268562.0,"ammortamenti":21715.0,"interessi_passivi":5361.0,"utile_ante_imposte":53175.0,"imposte":20365.0,"totale_attivo":1136175.0,"immobilizzazioni":137830.0,"crediti_clienti":547060.0,"rimanenze":50000.0,"liquidita":211783.0,"patrimonio_netto":229164.0,"debiti_totali":907011.0,"debiti_breve":0,"roi":9.87,"roe":0,"current_ratio":1.67,"debt_equity":206.8,"dso":101.21,"dpo":50.22}]},{"id":"BG415406","nome":"VIPLASTIC SRL","settore":"Fabbricazione di articoli in materie plastiche","ateco":"222","stato":"Attiva","rating":"A","rating_desc":"Rischio Molto Basso","rating_score":74,"rating_prev":"Rischio Molto Basso","limite_credito":230000,"anni":[{"anno":"2022","fatturato":32926202.0,"ebitda":2223147,"ebitda_margin":6.75,"op_margin":3.11,"net_margin":2.59,"utile_operativo":1025205.0,"utile_netto":851422.0,"salari":1466422.0,"ammortamenti":1197942.0,"interessi_passivi":120691.0,"utile_ante_imposte":911521.0,"imposte":60099.0,"totale_attivo":21506966.0,"immobilizzazioni":6370186.0,"crediti_clienti":10543667.0,"rimanenze":2923321.0,"liquidita":878678.0,"patrimonio_netto":4791986.0,"debiti_totali":16714980.0,"debiti_breve":0,"roi":9.01,"roe":0,"current_ratio":1.32,"debt_equity":162.68,"dso":116.88,"dpo":85.45},{"anno":"2021","fatturato":27475810.0,"ebitda":2558668,"ebitda_margin":9.31,"op_margin":5.72,"net_margin":4.08,"utile_operativo":1571506.0,"utile_netto":1121586.0,"salari":1169542.0,"ammortamenti":987162.0,"interessi_passivi":79657.0,"utile_ante_imposte":1492079.0,"imposte":370493.0,"totale_attivo":20185828.0,"immobilizzazioni":4318297.0,"crediti_clienti":10079893.0,"rimanenze":2931682.0,"liquidita":1870580.0,"patrimonio_netto":4061811.0,"debiti_totali":16124017.0,"debiti_breve":0,"roi":14.91,"roe":0,"current_ratio":1.56,"debt_equity":192.88,"dso":133.91,"dpo":93.11},{"anno":"2020","fatturato":16473587.0,"ebitda":1833329,"ebitda_margin":11.13,"op_margin":5.47,"net_margin":4.09,"utile_operativo":901415.0,"utile_netto":673404.0,"salari":833142.0,"ammortamenti":931914.0,"interessi_passivi":85966.0,"utile_ante_imposte":816201.0,"imposte":142797.0,"totale_attivo":14786940.0,"immobilizzazioni":4353491.0,"crediti_clienti":6106272.0,"rimanenze":2648338.0,"liquidita":1024347.0,"patrimonio_netto":3208590.0,"debiti_totali":11578350.0,"debiti_breve":0,"roi":11.32,"roe":0,"current_ratio":1.37,"debt_equity":161.47,"dso":135.29,"dpo":128.29},{"anno":"2019","fatturato":16900205.0,"ebitda":1903374,"ebitda_margin":11.26,"op_margin":6.05,"net_margin":4.39,"utile_operativo":1021698.0,"utile_netto":742338.0,"salari":884431.0,"ammortamenti":881676.0,"interessi_passivi":87542.0,"utile_ante_imposte":936662.0,"imposte":194324.0,"totale_attivo":14068821.0,"immobilizzazioni":4677556.0,"crediti_clienti":5942699.0,"rimanenze":2568338.0,"liquidita":308609.0,"patrimonio_netto":2411443.0,"debiti_totali":11657378.0,"debiti_breve":0,"roi":17.81,"roe":0,"current_ratio":1.07,"debt_equity":245.88,"dso":128.35,"dpo":111.78},{"anno":"2018","fatturato":18060582.0,"ebitda":1930322,"ebitda_margin":10.69,"op_margin":6.49,"net_margin":4.45,"utile_operativo":1171488.0,"utile_netto":804521.0,"salari":859256.0,"ammortamenti":758834.0,"interessi_passivi":78944.0,"utile_ante_imposte":1092557.0,"imposte":288036.0,"totale_attivo":13929087.0,"immobilizzazioni":3859938.0,"crediti_clienti":6209029.0,"rimanenze":2557090.0,"liquidita":1091149.0,"patrimonio_netto":2069365.0,"debiti_totali":11859722.0,"debiti_breve":0,"roi":22.11,"roe":0,"current_ratio":1.12,"debt_equity":285.64,"dso":125.48,"dpo":101.43}]}];

const BM = {
  '43210': { ebitda_margin:7.2, op_margin:4.8, net_margin:2.9, current_ratio:1.35, debt_equity:185, dso:85, roi:10.5 },
  '222':   { ebitda_margin:9.8, op_margin:5.5, net_margin:3.8, current_ratio:1.45, debt_equity:145, dso:95, roi:12.8 },
};

// ── UTILS ─────────────────────────────────────────────────────
const fmt = (n,d=0) => {
  if(!n && n!==0) return '—';
  const a = Math.abs(n);
  if(a>=1000000) return (n/1000000).toFixed(1)+'M';
  if(a>=1000) return (n/1000).toFixed(0)+'K';
  return n.toFixed ? n.toFixed(d) : String(n);
};
const fmtE = n => n ? '€'+fmt(n) : '—';
const fmtP = n => n ? n.toFixed(1)+'%' : '—';

function computeScore(d) {
  const a = d.anni[0];
  const bm = BM[d.ateco] || BM['43210'];
  const n = d.anni.length;
  let s = 0;
  // Solidità patrimoniale (0-20)
  s += Math.min(20, (a.patrimonio_netto / a.totale_attivo * 100) * 0.8);
  // Redditività vs benchmark (0-20)
  s += Math.min(20, (a.ebitda_margin / bm.ebitda_margin) * 10);
  // Liquidità (0-15)
  s += Math.min(15, a.current_ratio * 8);
  // Gestione crediti (0-15)
  s += Math.min(15, Math.max(0, 15 - (a.dso - bm.dso) * 0.15));
  // Trend (0-15)
  const fatG = n>1 ? (d.anni[0].fatturato - d.anni[n-1].fatturato)/d.anni[n-1].fatturato : 0;
  s += Math.min(15, Math.max(0, 7.5 + fatG*30));
  // Leva (0-15)
  s += Math.min(15, Math.max(0, 15 - (a.debt_equity - 100) * 0.05));
  return Math.round(s);
}

function detectAnomalies(d) {
  const out = [];
  const a = d.anni, n = a.length;
  if(n<2) return out;
  if(a[0].fatturato < a[1].fatturato && a[0].ebitda_margin < a[1].ebitda_margin)
    out.push({sev:'critical',msg:'Doppia pressione: fatturato e margini in calo simultaneo',azione:'Richiedi piano industriale aggiornato'});
  if((a[0].debiti_totali-a[n-1].debiti_totali)/a[n-1].debiti_totali > (a[0].fatturato-a[n-1].fatturato)/a[n-1].fatturato + 0.15)
    out.push({sev:'critical',msg:'Debiti crescono più velocemente del fatturato',azione:'Analisi struttura debitoria con scadenzario'});
  if(a[0].current_ratio < 1.2 && a[0].current_ratio > 0)
    out.push({sev:'critical',msg:'Rapporto corrente sotto la soglia di sicurezza 1.2',azione:'Monitora liquidità mensile'});
  if(a[0].utile_netto > 0 && a[0].liquidita < a[1].liquidita * 0.7)
    out.push({sev:'warn',msg:'Calo di liquidità nonostante utili positivi',azione:'Verifica assorbimento da investimenti o rimborsi debiti'});
  if(a[0].immobilizzazioni > a[n-1].immobilizzazioni * 1.8)
    out.push({sev:'warn',msg:'Investimenti significativi nel periodo — capex elevato',azione:'Verifica copertura finanziaria degli investimenti'});
  if(a[0].dso > 0 && a[0].dso < a[n-1].dso * 0.85)
    out.push({sev:'ok',msg:'Miglioramento tempi di riscossione crediti',azione:'Positivo — mantenere il monitoraggio'});
  if(a[0].debt_equity < a[n-1].debt_equity * 0.85)
    out.push({sev:'ok',msg:'Riduzione progressiva della leva finanziaria',azione:'Segnale di consolidamento — continuare a monitorare'});
  return out;
}

function predictRating(d) {
  const a = d.anni, n = a.length;
  const sc = computeScore(d);
  const bm = BM[d.ateco] || BM['43210'];

  // Trend EBITDA margin ultimi 2 anni
  const ebitdaTrend = n>1 ? a[0].ebitda_margin - a[1].ebitda_margin : 0;
  // Trend current ratio
  const crTrend = n>1 ? a[0].current_ratio - a[1].current_ratio : 0;
  // Trend fatturato
  const fatTrend = n>1 ? (a[0].fatturato - a[1].fatturato)/a[1].fatturato*100 : 0;
  // Trend patrimonio
  const pnTrend = n>1 ? (a[0].patrimonio_netto - a[1].patrimonio_netto)/a[1].patrimonio_netto*100 : 0;

  // Score delta previsto
  let delta = 0;
  delta += ebitdaTrend * 1.5;
  delta += crTrend * 5;
  delta += fatTrend * 0.3;
  delta += pnTrend * 0.4;

  const scFuturo = Math.min(100, Math.max(0, sc + delta));

  // Probabilità stati
  let pMiglio = 0, pStabile = 0, pRischio = 0, pCritico = 0;

  if(delta > 5) { pMiglio=55; pStabile=35; pRischio=8; pCritico=2; }
  else if(delta > 0) { pMiglio=20; pStabile=60; pRischio=16; pCritico=4; }
  else if(delta > -5) { pMiglio=5; pStabile=45; pRischio=38; pCritico=12; }
  else { pMiglio=2; pStabile=18; pRischio=45; pCritico=35; }

  const fattori = [
    { label:'Tendenza EBITDA', val: ebitdaTrend>0 ? '+'+ebitdaTrend.toFixed(1)+'pp' : ebitdaTrend.toFixed(1)+'pp', cls: ebitdaTrend>0?'factor-pos':ebitdaTrend<-1?'factor-neg':'factor-neu' },
    { label:'Tendenza liquidità', val: crTrend>0 ? '+'+crTrend.toFixed(2) : crTrend.toFixed(2), cls: crTrend>0?'factor-pos':crTrend<-0.1?'factor-neg':'factor-neu' },
    { label:'Crescita fatturato', val: fatTrend>0 ? '+'+fatTrend.toFixed(1)+'%' : fatTrend.toFixed(1)+'%', cls: fatTrend>5?'factor-pos':fatTrend<-5?'factor-neg':'factor-neu' },
    { label:'Crescita patrimonio', val: pnTrend>0 ? '+'+pnTrend.toFixed(1)+'%' : pnTrend.toFixed(1)+'%', cls: pnTrend>3?'factor-pos':pnTrend<0?'factor-neg':'factor-neu' },
    { label:'Posiz. vs settore', val: a[0].ebitda_margin > (bm.ebitda_margin||7) ? 'Sopra media' : 'Sotto media', cls: a[0].ebitda_margin > (bm.ebitda_margin||7) ? 'factor-pos':'factor-neg' },
  ];

  const stato = pMiglio>40 ? 'miglio' : pStabile>50 ? 'stabile' : pCritico>30 ? 'critico' : 'rischio';
  const prob = pMiglio>40 ? pMiglio : pStabile>50 ? pStabile : pCritico>30 ? pCritico : pRischio;

  return { sc, scFuturo:Math.round(scFuturo), delta:Math.round(delta), stato, prob,
           pMiglio, pStabile, pRischio, pCritico, fattori,
           narrativa: buildNarrativa(d, stato, delta, fattori) };
}

function buildNarrativa(d, stato, delta, fattori) {
  const a = d.anni[0];
  if(stato==='miglio') return `I trend di ${d.nome} indicano un miglioramento strutturale atteso nei prossimi 12 mesi. L'EBITDA in recupero e la liquidità in crescita suggeriscono una traiettoria positiva. Il rating CreditSafe ${d.rating} potrebbe essere rivisto al rialzo se il trend si consolida.`;
  if(stato==='stabile') return `${d.nome} mostra stabilità nei fondamentali. Nessun segnale di deterioramento imminente, ma anche nessun catalizzatore di miglioramento evidente. Il monitoraggio trimestrale è sufficiente. Rating atteso invariato.`;
  if(stato==='rischio') return `I segnali di ${d.nome} indicano una pressione crescente sui margini e sulla liquidità. Se il trend non si inverte nei prossimi 6 mesi, il rischio di un downgrade del rating aumenta significativamente. Aumentare la frequenza di monitoraggio.`;
  return `${d.nome} mostra segnali di deterioramento multiplo. La combinazione di margini in calo, leva elevata e liquidità sotto pressione configura un profilo di rischio elevato per i prossimi 12-18 mesi. Azione immediata raccomandata.`;
}

// ── PORTAFOGLIO ───────────────────────────────────────────────
function renderPortafoglio() {
  const sorted = [...PORTFOLIO].sort((a,b) => computeScore(b) - computeScore(a));

  // Summary
  const totFat = PORTFOLIO.reduce((s,d) => s + d.anni[0].fatturato, 0);
  const totExp = PORTFOLIO.reduce((s,d) => s + d.limite_credito, 0);
  const critical = PORTFOLIO.filter(d => detectAnomalies(d).some(a => a.sev==='critical')).length;
  const ratingDist = PORTFOLIO.reduce((m,d) => { m[d.rating]=(m[d.rating]||0)+1; return m; }, {});

  document.getElementById('summary-row').innerHTML = `
    <div class="sum-card">
      <div class="sum-label">Aziende in Portafoglio</div>
      <div class="sum-val">${PORTFOLIO.length}</div>
      <div class="sum-sub">Dati CreditSafe aggiornati</div>
    </div>
    <div class="sum-card">
      <div class="sum-label">Fatturato Aggregato</div>
      <div class="sum-val">${fmtE(totFat)}</div>
      <div class="sum-sub">Ultimo anno disponibile</div>
    </div>
    <div class="sum-card">
      <div class="sum-label">Esposizione Credito</div>
      <div class="sum-val">${fmtE(totExp)}</div>
      <div class="sum-sub">Limite CreditSafe aggregato</div>
    </div>
    <div class="sum-card">
      <div class="sum-label">Aziende con Alert</div>
      <div class="sum-val" style="color:${critical>0?'var(--red)':'var(--green)'}">${critical}</div>
      <div class="sum-sub">Anomalie critiche rilevate</div>
    </div>
    <div class="sum-card">
      <div class="sum-label">Distribuzione Rating</div>
      <div style="display:flex;gap:0.4rem;margin-top:0.3rem;flex-wrap:wrap">
        ${Object.entries(ratingDist).map(([r,n]) => `<span class="alert-badge ${r==='A'?'badge-ok':r==='B'?'badge-ok':r==='C'?'badge-warn':'badge-critical'}">${r}: ${n}</span>`).join('')}
      </div>
    </div>`;

  document.getElementById('company-grid').innerHTML = sorted.map(d => {
    const sc = computeScore(d);
    const a = d.anni[0];
    const anoms = detectAnomalies(d);
    const critCount = anoms.filter(x => x.sev==='critical').length;
    const scoreColor = sc>=70?'var(--green)':sc>=50?'var(--viola)':'var(--red)';
    const scoreBg = sc>=70?'var(--green-bg)':sc>=50?'var(--viola-bg)':'var(--red-bg)';
    return `
    <div class="company-card" onclick="openDetail('${d.id}')">
      <div class="card-stripe stripe-${d.rating}"></div>
      <div>
        <div class="card-name">${d.nome}</div>
        <div class="card-sector">${d.settore.substring(0,35)}${d.settore.length>35?'…':''}</div>
        <div style="margin-top:0.4rem">
          ${critCount>0 ? '<span class="alert-badge badge-critical">'+critCount+' alert</span>' : '<span class="alert-badge badge-ok">OK</span>'}
        </div>
      </div>
      <div></div>
      <div class="card-kpi"><div class="card-kpi-label">Fatturato</div><div class="card-kpi-val">${fmtE(a.fatturato)}</div></div>
      <div class="card-kpi"><div class="card-kpi-label">EBITDA %</div><div class="card-kpi-val ${a.ebitda_margin>7?'up':a.ebitda_margin>4?'':'warn'}">${fmtP(a.ebitda_margin)}</div></div>
      <div class="card-kpi"><div class="card-kpi-label">Liq. Corrente</div><div class="card-kpi-val ${a.current_ratio>=1.4?'up':a.current_ratio>=1.2?'':'warn'}">${a.current_ratio.toFixed(2)}</div></div>
      <div class="card-kpi"><div class="card-kpi-label">Gg. Incasso</div><div class="card-kpi-val ${a.dso<70?'up':a.dso<90?'':'warn'}">${a.dso.toFixed(0)}</div></div>
      <div class="score-col">
        <div class="score-circle" style="background:${scoreBg};color:${scoreColor};border:2px solid ${scoreColor}">${sc}</div>
        <div style="font-size:0.5rem;text-align:center;color:var(--text3);margin-top:0.2rem">Punteggio</div>
      </div>
      <div style="display:flex;align-items:center;justify-content:flex-end;gap:0.6rem">
        <div class="rating-pill pill-${d.rating}">${d.rating}</div>
        <div style="font-size:0.55rem;color:var(--text3);text-align:right">${d.rating_score}/100<br>${d.rating_desc}</div>
      </div>
    </div>`;
  }).join('');
}

// ── DETAIL ────────────────────────────────────────────────────
let currentDetailId = null;

function openDetail(id) {
  currentDetailId = id;
  const d = PORTFOLIO.find(x => x.id===id);
  document.getElementById('detail-title').textContent = d.nome;
  document.getElementById('detail-sub').textContent = d.settore + ' · ATECO ' + d.ateco + ' · Rating ' + d.rating;
  setDTab('panoramica');
  showView('detail');
}

function setDTab(tab) {
  document.querySelectorAll('.dtab').forEach(b => b.classList.toggle('active', b.textContent.toLowerCase().includes(tab)||b.getAttribute('onclick').includes(tab)));
  document.querySelectorAll('.dtab-content').forEach(c => c.classList.remove('active'));
  document.getElementById('dtab-'+tab).classList.add('active');
  renderDTab(tab);
}

function renderDTab(tab) {
  const d = PORTFOLIO.find(x => x.id===currentDetailId);
  const a = d.anni[0];
  const bm = BM[d.ateco] || BM['43210'];

  if(tab==='panoramica') {
    const sc = computeScore(d);
    const scoreColor = sc>=70?'var(--green)':sc>=50?'var(--viola)':'var(--red)';
    document.getElementById('dtab-panoramica').innerHTML = `
      <div class="kpi-grid">
        ${[
          {l:'Fatturato',v:fmtE(a.fatturato),cls:''},
          {l:'EBITDA',v:fmtE(a.ebitda),cls:''},
          {l:'Margine EBITDA',v:fmtP(a.ebitda_margin),cls:a.ebitda_margin>bm.ebitda_margin?'up':'warn'},
          {l:'Utile Netto',v:fmtE(a.utile_netto),cls:a.utile_netto>0?'up':'down'},
          {l:'Patrimonio Netto',v:fmtE(a.patrimonio_netto),cls:''},
          {l:'Liquidità',v:fmtE(a.liquidita),cls:''},
          {l:'Liq. Corrente',v:a.current_ratio.toFixed(2),cls:a.current_ratio>=1.4?'up':a.current_ratio>=1.2?'':'warn'},
          {l:'Leva D/E',v:fmtP(a.debt_equity),cls:a.debt_equity<150?'up':a.debt_equity>250?'down':''},
        ].map(k => `<div class="kpi-cell"><div class="kpi-label">${k.l}</div><div class="kpi-val ${k.cls}">${k.v}</div></div>`).join('')}
      </div>
      <div class="charts-2col">
        ${['fatturato','ebitda','utile_netto','liquidita'].map((k,i) => {
          const labels = ['Fatturato','EBITDA','Utile Netto','Liquidità'];
          const colors = ['#5b3d8f','#c9a84c','#1e8449','#4a90d9'];
          const vals = d.anni.map(a => a[k]);
          const max = Math.max(...vals.map(Math.abs));
          return `<div class="chart-card">
            <div class="chart-title">${labels[i]}</div>
            <div class="bars">
              ${d.anni.map(a => {
                const h = max>0 ? Math.max(3, Math.abs(a[k])/max*65) : 3;
                const col = a[k]>=0 ? colors[i] : 'var(--red)';
                return `<div class="bar-wrap"><div class="bar" style="height:${h}px;background:${col}"></div><div class="bar-lbl">${a.anno}</div></div>`;
              }).join('')}
            </div>
          </div>`;
        }).join('')}
      </div>`;
  }

  if(tab==='dati') {
    const rows = [
      {l:'Fatturato',k:'fatturato',f:fmtE},
      {l:'EBITDA',k:'ebitda',f:fmtE},
      {l:'Margine EBITDA',k:'ebitda_margin',f:fmtP,bm:'ebitda_margin'},
      {l:'Margine Netto',k:'net_margin',f:fmtP,bm:'net_margin'},
      {l:'Utile Netto',k:'utile_netto',f:fmtE},
      {l:'Patrimonio Netto',k:'patrimonio_netto',f:fmtE},
      {l:'Totale Attivo',k:'totale_attivo',f:fmtE},
      {l:'Liquidità',k:'liquidita',f:fmtE},
      {l:'Liq. Corrente',k:'current_ratio',f:v=>v.toFixed(2),bm:'current_ratio'},
      {l:'Leva D/E',k:'debt_equity',f:fmtP,bm:'debt_equity',inv:true},
      {l:'Gg. Incasso',k:'dso',f:v=>v.toFixed(0)+'gg',bm:'dso',inv:true},
      {l:'ROI',k:'roi',f:fmtP,bm:'roi'},
    ];
    document.getElementById('dtab-dati').innerHTML = `
      <table class="data-tbl">
        <thead><tr>
          <th>Indicatore</th>
          ${d.anni.map(a => `<th>${a.anno}</th>`).join('')}
          <th style="border-left:2px solid var(--viola-light);color:var(--viola-light)">Settore</th>
        </tr></thead>
        <tbody>
          ${rows.map(r => {
            const cells = d.anni.map(a => {
              const v = a[r.k];
              let cls = '';
              if(r.bm && bm[r.bm]) {
                const better = r.inv ? v < bm[r.bm] : v > bm[r.bm];
                cls = better ? 'pos' : Math.abs(v-bm[r.bm])/bm[r.bm] > 0.15 ? 'neg' : '';
              }
              return `<td class="${cls}">${r.f(v)}</td>`;
            }).join('');
            const bmCell = r.bm && bm[r.bm] ? `<td style="color:var(--text3);border-left:2px solid var(--viola-light)">${r.f(bm[r.bm])}</td>` : '<td></td>';
            return `<tr><td>${r.l}</td>${cells}${bmCell}</tr>`;
          }).join('')}
        </tbody>
      </table>`;
  }

  if(tab==='anomalie') {
    const anoms = detectAnomalies(d);
    document.getElementById('dtab-anomalie').innerHTML = `
      <div style="display:flex;flex-direction:column;gap:0.8rem">
        ${anoms.map((an, idx) => `
          <div style="background:#fff;border:1px solid var(--border);border-radius:6px;padding:1rem;display:flex;gap:1rem;align-items:flex-start">
            <div style="width:4px;align-self:stretch;border-radius:2px;background:${an.sev==='critical'?'var(--red)':an.sev==='warn'?'var(--amber)':'var(--green)'}"></div>
            <div style="flex:1">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem">
                <div>
                  <div style="font-size:0.68rem;font-weight:600;margin-bottom:0.2rem">${an.msg}</div>
                  <div style="font-size:0.6rem;color:var(--text3)">Azione: ${an.azione}</div>
                </div>
                <button onclick="interpretaSegnale('${d.id}',${idx})" style="flex-shrink:0;padding:0.3rem 0.8rem;background:var(--viola);color:#fff;border:none;border-radius:3px;font-family:'IBM Plex Mono',monospace;font-size:0.55rem;cursor:pointer;white-space:nowrap">◆ Interpreta</button>
              </div>
              <div id="interp-${d.id}-${idx}" style="display:none;margin-top:0.8rem;padding:0.8rem;background:var(--viola-bg);border-radius:4px">
                <div style="font-size:0.55rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--viola);margin-bottom:0.4rem">◆ Superrisponditore</div>
                <div id="interp-text-${d.id}-${idx}" style="font-family:'Cormorant Garamond',serif;font-size:0.9rem;line-height:1.9;color:var(--text)"></div>
              </div>
            </div>
          </div>`).join('')}
        ${anoms.length===0 ? '<div style="padding:1rem;color:var(--text3)">Nessuna anomalia rilevata.</div>' : ''}
      </div>`;
  }

  if(tab==='analisi') {
    const cached = window._analisiCache && window._analisiCache[d.id];
    document.getElementById('dtab-analisi').innerHTML = `
      <div style="display:flex;gap:0.6rem;margin-bottom:1rem">
        <button class="btn btn-viola" onclick="runAnalisi('${d.id}')">◆ Avvia Analisi Completa</button>
        ${cached ? '<button class="btn btn-ghost" onclick="runAnalisi(\''+d.id+'\',true)">↺ Rigenera</button>' : ''}
      </div>
      <div class="ai-panel">
        <div class="ai-header">
          <span>◆ Superrisponditore · Due Diligence ${d.nome}</span>
          <span id="analisi-status-${d.id}">${cached?'Completata':'In attesa'}</span>
        </div>
        <div class="ai-body" id="analisi-body-${d.id}">
          ${cached ? '<div class="ai-text">'+cached+'</div>' : '<div class="loading">Avvia l\'analisi</div>'}
        </div>
      </div>`;
  }
}

async function interpretaSegnale(companyId, idx) {
  const d = PORTFOLIO.find(x => x.id===companyId);
  const anoms = detectAnomalies(d);
  const an = anoms[idx];
  const box = document.getElementById('interp-'+companyId+'-'+idx);
  const txt = document.getElementById('interp-text-'+companyId+'-'+idx);
  box.style.display = 'block';
  txt.innerHTML = '<span style="color:var(--text3)">Analisi in corso...</span>';

  const a = d.anni[0];
  const serie = d.anni.map(x => x.anno+': Fat '+fmtE(x.fatturato)+' EBITDA% '+fmtP(x.ebitda_margin)+' PN '+fmtE(x.patrimonio_netto)+' Liq '+fmtE(x.liquidita)+' CR '+x.current_ratio.toFixed(2)).join(' / ');

  const prompt = `Sei il Superrisponditore, Chief Credit Officer senior. Interpreta questo segnale finanziario in modo chirurgico.

AZIENDA: ${d.nome} (ATECO ${d.ateco}) | Rating: ${d.rating} | Punteggio: ${d.rating_score}/100
DATI: ${serie}

SEGNALE [${an.sev.toUpperCase()}]: ${an.msg}

Rispondi in tre parti concise:
1. CAUSA PROBABILE — il fenomeno economico reale, non il numero
2. IMPATTO SUL RISCHIO — peso sul profilo complessivo, cosa può succedere
3. AZIONE OPERATIVA — cosa fare concretamente, quale clausola, quale soglia

Max 180 parole. Chirurgico, diretto, zero generalità.`;

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:4000, messages:[{role:'user',content:prompt}] })
    });
    const data = await r.json();
    txt.innerHTML = (data.content?.[0]?.text||'Errore').replace(/\n/g,'<br>');
  } catch(e) {
    txt.innerHTML = '<span style="color:var(--red)">Errore: '+e.message+'</span>';
  }
}

async function runAnalisi(id, force=false) {
  if(!window._analisiCache) window._analisiCache = {};
  if(window._analisiCache[id] && !force) return;
  const d = PORTFOLIO.find(x => x.id===id);
  const btn = document.querySelector(`#dtab-analisi button`);
  const body = document.getElementById('analisi-body-'+id);
  const status = document.getElementById('analisi-status-'+id);
  if(btn) btn.disabled = true;
  if(status) status.textContent = 'In elaborazione...';
  if(body) body.innerHTML = '<div class="loading">Il Superrisponditore sta analizzando i bilanci</div>';

  const bm = BM[d.ateco] || BM['43210'];
  const n = d.anni.length;
  const serie = d.anni.map(a => a.anno+': Fatturato '+fmtE(a.fatturato)+' | EBITDA '+fmtE(a.ebitda)+' ('+fmtP(a.ebitda_margin)+') | Utile '+fmtE(a.utile_netto)+' | Patrimonio '+fmtE(a.patrimonio_netto)+' | Liquidità '+fmtE(a.liquidita)+' | CR '+a.current_ratio.toFixed(2)+' | D/E '+fmtP(a.debt_equity)+' | Gg.Inc '+a.dso.toFixed(0)).join('\n');
  const anoms = detectAnomalies(d).map(a => '['+a.sev.toUpperCase()+'] '+a.msg).join('\n');
  const sc = computeScore(d);
  const pred = predictRating(d);

  const prompt = `Sei il Chief Credit Officer di una primaria banca d'investimento europea, 25 anni di esperienza su PMI italiane.

AZIENDA: ${d.nome} | ATECO ${d.ateco} - ${d.settore}
RATING CREDITSAFE: ${d.rating} (${d.rating_desc}) | Score: ${d.rating_score}/100 | Precedente: ${d.rating_prev}
LIMITE CREDITO: €${d.limite_credito.toLocaleString()}
PUNTEGGIO PROPRIETARIO: ${sc}/100
PREVISIONE 12 MESI: scenario ${pred.stato} (probabilità ${pred.prob}%)

SERIE STORICA ${d.anni[n-1].anno}–${d.anni[0].anno}:
${serie}

BENCHMARK ATECO ${d.ateco}: EBITDA% ${fmtP(bm.ebitda_margin)} | Marg.Op. ${fmtP(bm.op_margin)} | CR ${bm.current_ratio} | D/E ${fmtP(bm.debt_equity)} | Gg.Inc ${bm.dso} | ROI ${fmtP(bm.roi)}

ANOMALIE RILEVATE:
${anoms||'Nessuna critica'}

Produci una due diligence professionale di livello senior in sei sezioni:

1. NARRATIVA STORICA — cosa è successo anno per anno, cosa si legge tra le righe
2. DIAGNOSI STRUTTURALE — come è fatta questa azienda, dove si forma e dove si perde valore
3. RISCHI LATENTI — quelli non ovvi, che si vedono solo nelle relazioni tra indicatori
4. PUNTI DI FORZA — cosa fa bene che i numeri non mostrano esplicitamente
5. VERDETTO SUL RATING — il rating ${d.rating} è corretto? Il tuo punteggio ${sc}/100 conferma o contraddice?
6. RACCOMANDAZIONE OPERATIVA — limite credito preciso e motivato, condizioni, clausole, segnali da monitorare

Italiano. Tono da advisor senior. Chirurgico, diretto, giudizi netti. Minimo 700 parole.`;

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:4000, messages:[{role:'user',content:prompt}] })
    });
    const data = await r.json();
    const text = data.content?.[0]?.text || 'Errore.';
    window._analisiCache[id] = text;
    if(body) body.innerHTML = '<div class="ai-text">'+text.replace(/\n/g,'<br>')+'</div>';
    if(status) status.textContent = 'Completata';
    if(btn) { btn.disabled=false; btn.textContent='↺ Rigenera'; }
  } catch(e) {
    if(body) body.innerHTML = '<span style="color:var(--red)">Errore: '+e.message+'</span>';
    if(btn) btn.disabled=false;
  }
}

// ── PREDITTIVO ────────────────────────────────────────────────
function renderPredittivo() {
  document.getElementById('pred-grid').innerHTML = PORTFOLIO.map(d => {
    const p = predictRating(d);
    const gaugeClass = 'gauge-'+p.stato;
    const statiLabel = {miglio:'Miglioramento',stabile:'Stabile',rischio:'Sotto pressione',critico:'Deterioramento'};
    return `
    <div class="pred-card">
      <div class="pred-company">${d.nome} · Rating attuale: ${d.rating}</div>
      <div class="pred-gauge">
        <div class="gauge-circle ${gaugeClass}">
          <div class="gauge-pct">${p.prob}%</div>
          <div class="gauge-lbl">${statiLabel[p.stato]}</div>
        </div>
        <div class="pred-factors">
          <div style="font-size:0.55rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text3);margin-bottom:0.4rem">Fattori determinanti</div>
          ${p.fattori.map(f => `<div class="pred-factor"><span>${f.label}</span><span class="${f.cls}">${f.val}</span></div>`).join('')}
        </div>
      </div>
      <div style="display:flex;gap:0.4rem;margin-bottom:0.8rem;flex-wrap:wrap">
        <span class="alert-badge badge-ok">Migliora ${p.pMiglio}%</span>
        <span class="alert-badge" style="background:#eef0f7;color:var(--viola);border:1px solid var(--border2)">Stabile ${p.pStabile}%</span>
        <span class="alert-badge badge-warn">Pressione ${p.pRischio}%</span>
        <span class="alert-badge badge-critical">Critico ${p.pCritico}%</span>
      </div>
      <div class="pred-narrative">${p.narrativa}</div>
      <div style="margin-top:0.8rem;display:flex;justify-content:space-between;font-size:0.6rem;color:var(--text3)">
        <span>Punteggio attuale: <strong style="color:var(--viola)">${p.sc}/100</strong></span>
        <span>Punteggio atteso 12m: <strong style="color:${p.scFuturo>p.sc?'var(--green)':'var(--red)'}">${p.scFuturo}/100</strong></span>
      </div>
    </div>`;
  }).join('');
}

async function runPredittivo() {
  renderPredittivo();
}

// ── STRESS TEST ───────────────────────────────────────────────
function updateStress() {
  const fat = parseInt(document.getElementById('sl-fatturato').value);
  const tassi = parseFloat(document.getElementById('sl-tassi').value);
  const incasso = parseInt(document.getElementById('sl-incasso').value);
  const costi = parseInt(document.getElementById('sl-costi').value);
  const liq = parseInt(document.getElementById('sl-liquidita').value);

  document.getElementById('sv-fatturato').textContent = '-'+fat+'%';
  document.getElementById('sv-tassi').textContent = '+'+tassi+'%';
  document.getElementById('sv-incasso').textContent = incasso+'%';
  document.getElementById('sv-costi').textContent = '+'+costi+'%';
  document.getElementById('sv-liquidita').textContent = '-'+liq+'%';

  document.getElementById('stress-results').innerHTML = PORTFOLIO.map(d => {
    const a = d.anni[0];
    const fatS = a.fatturato * (1 - fat/100);
    const ebitdaS = Math.max(0, a.ebitda - (a.fatturato - fatS) - (a.fatturato * costi/100));
    const ebitdaMargS = fatS>0 ? ebitdaS/fatS*100 : 0;
    const interessiS = a.interessi_passivi * (1 + tassi/2);
    const utileS = ebitdaS - a.ammortamenti - interessiS - a.imposte;
    const liquS = a.liquidita * (1 - liq/100) - (a.crediti_clienti * incasso/100);
    const crS = a.totale_attivo > 0 ? (a.totale_attivo - a.immobilizzazioni) / (a.debiti_totali * 0.5) : 0;

    const verdetto = liquS < 0 ? 'critical' : (ebitdaS < 0 || crS < 1.0) ? 'warn' : 'ok';
    const verdLabel = {ok:'Struttura regge lo scenario',warn:'Pressione significativa — monitorare',critical:'Scenario critico — rischio liquidità'}[verdetto];

    return `
    <div class="stress-card">
      <div class="stress-company">${d.nome} · Rating ${d.rating}</div>
      <div class="stress-kpis">
        ${[
          {l:'Fatturato',base:fmtE(a.fatturato),new:fmtE(fatS),ok:true},
          {l:'EBITDA%',base:fmtP(a.ebitda_margin),new:fmtP(ebitdaMargS),ok:ebitdaMargS>3},
          {l:'Utile Netto',base:fmtE(a.utile_netto),new:fmtE(utileS),ok:utileS>0},
          {l:'Liquidità',base:fmtE(a.liquidita),new:fmtE(liquS),ok:liquS>0},
        ].map(k => `<div class="stress-kpi">
          <div class="stress-kpi-label">${k.l}</div>
          <div class="stress-kpi-base">${k.base}</div>
          <div class="stress-kpi-new" style="color:${k.ok?'var(--green)':'var(--red)'}">${k.new}</div>
        </div>`).join('')}
      </div>
      <div class="stress-verdict verdict-${verdetto}">${verdLabel}</div>
    </div>`;
  }).join('');
}

function setScenario(name) {
  const scenarios = {
    recessione:     [20,1,10,10,20],
    crisi_liquidita:[10,2,20,5,50],
    cliente_insolvente:[5,0,25,0,15],
    tassi_alti:     [5,4,5,8,10],
  };
  const v = scenarios[name];
  ['fatturato','tassi','incasso','costi','liquidita'].forEach((id,i) => {
    document.getElementById('sl-'+id).value = v[i];
  });
  updateStress();
}

// ── ALERT ─────────────────────────────────────────────────────
function renderAlert() {
  const allAlerts = PORTFOLIO.flatMap(d =>
    detectAnomalies(d).map(a => ({ ...a, company: d.nome, ateco: d.ateco, rating: d.rating, id: d.id }))
  ).sort((a,b) => (a.sev==='critical'?0:a.sev==='warn'?1:2) - (b.sev==='critical'?0:b.sev==='warn'?1:2));

  const critical = allAlerts.filter(a => a.sev==='critical');
  const warn = allAlerts.filter(a => a.sev==='warn');
  const ok = allAlerts.filter(a => a.sev==='ok');

  document.getElementById('alert-panels').innerHTML = `
    <div class="alert-panel">
      <div class="alert-panel-header">
        <span>🔴 Alert Critici (${critical.length})</span>
        <span>Azione immediata raccomandata</span>
      </div>
      <div class="alert-list">
        ${critical.length ? critical.map(a => `
          <div class="alert-item">
            <div class="alert-bar bar-critical"></div>
            <div><div class="alert-company">${a.company}</div><div class="alert-sector">Rating ${a.rating}</div></div>
            <div class="alert-msg">${a.msg}</div>
            <div class="alert-action action-critical">${a.azione}</div>
          </div>`).join('') : '<div style="padding:1rem;color:var(--text3)">Nessun alert critico</div>'}
      </div>
    </div>
    <div class="alert-panel" style="margin-top:1rem">
      <div class="alert-panel-header" style="background:var(--amber)">
        <span>🟡 Da Monitorare (${warn.length})</span>
        <span>Sorveglianza trimestrale</span>
      </div>
      <div class="alert-list">
        ${warn.length ? warn.map(a => `
          <div class="alert-item">
            <div class="alert-bar bar-warn"></div>
            <div><div class="alert-company">${a.company}</div><div class="alert-sector">Rating ${a.rating}</div></div>
            <div class="alert-msg">${a.msg}</div>
            <div class="alert-action action-warn">${a.azione}</div>
          </div>`).join('') : '<div style="padding:1rem;color:var(--text3)">Nessun avvertimento</div>'}
      </div>
    </div>
    <div class="alert-panel" style="margin-top:1rem">
      <div class="alert-panel-header" style="background:var(--green)">
        <span>🟢 Segnali Positivi (${ok.length})</span>
      </div>
      <div class="alert-list">
        ${ok.map(a => `
          <div class="alert-item">
            <div class="alert-bar bar-info"></div>
            <div><div class="alert-company">${a.company}</div></div>
            <div class="alert-msg">${a.msg}</div>
            <div></div>
          </div>`).join('')}
      </div>
    </div>`;
}

async function runAlertAI() {
  document.getElementById('alert-ai-panel').style.display = 'block';
  document.getElementById('alert-ai-status').textContent = 'In elaborazione...';
  document.getElementById('alert-ai-body').innerHTML = '<div class="loading">Il Superrisponditore sta analizzando tutto il portafoglio</div>';

  const summary = PORTFOLIO.map(d => {
    const anoms = detectAnomalies(d);
    const sc = computeScore(d);
    const pred = predictRating(d);
    return `${d.nome} (Rating ${d.rating}, Punteggio ${sc}/100, Previsione: ${pred.stato}):\n  Anomalie: ${anoms.map(a=>'['+a.sev+'] '+a.msg).join('; ')||'nessuna'}`;
  }).join('\n\n');

  const prompt = `Sei il Chief Risk Officer. Analizza questo portafoglio clienti e produci un report di sorveglianza professionale.

PORTAFOGLIO:
${summary}

Produci:
1. VALUTAZIONE COMPLESSIVA DEL PORTAFOGLIO — qual è il rischio aggregato? Dove si concentra l'esposizione?
2. AZIENDE PRIORITARIE — chi richiede attenzione immediata e perché
3. PATTERN TRASVERSALI — ci sono rischi comuni a più aziende?
4. PIANO DI MONITORAGGIO — frequenza e indicatori da seguire per ciascuna
5. RACCOMANDAZIONI STRATEGICHE — cosa fare nei prossimi 30/90/180 giorni

Italiano. Tono da Chief Risk Officer. Concreto, decisionale, con scadenze precise.`;

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:4000, messages:[{role:'user',content:prompt}] })
    });
    const data = await r.json();
    const text = data.content?.[0]?.text || 'Errore.';
    document.getElementById('alert-ai-body').innerHTML = '<div class="ai-text">'+text.replace(/\n/g,'<br>')+'</div>';
    document.getElementById('alert-ai-status').textContent = 'Completata';
  } catch(e) {
    document.getElementById('alert-ai-body').innerHTML = '<span style="color:var(--red)">Errore: '+e.message+'</span>';
  }
}

// ── REPORT ────────────────────────────────────────────────────
let reportType = 'full';

function selectReport(type) {
  reportType = type;
  ['full','exec','credit'].forEach(t => {
    document.getElementById('ropt-'+t).classList.toggle('selected', t===type);
  });
}

function populateReportSelect() {
  const sel = document.getElementById('report-company');
  sel.innerHTML = PORTFOLIO.map(d => `<option value="${d.id}">${d.nome}</option>`).join('');
}

async function generateReport() {
  const id = document.getElementById('report-company').value;
  const mittente = document.getElementById('report-mittente').value;
  const destinatario = document.getElementById('report-destinatario').value;
  const d = PORTFOLIO.find(x => x.id===id);
  const out = document.getElementById('report-output');
  const sc = computeScore(d);
  const pred = predictRating(d);
  const anoms = detectAnomalies(d);
  const a = d.anni[0];
  const n = d.anni.length;

  out.innerHTML = '<span style="color:var(--text3)">Generazione documento in corso...</span>';
  document.getElementById('btn-copy').style.display = 'none';

  const serie = d.anni.map(x => x.anno+': Fat '+fmtE(x.fatturato)+' EBITDA% '+fmtP(x.ebitda_margin)+' Utile '+fmtE(x.utile_netto)+' CR '+x.current_ratio.toFixed(2)).join(' / ');

  const prompts = {
    full: `Sei il Chief Credit Officer. Redigi una lettera formale di due diligence finanziaria.

INTESTAZIONE: Da ${mittente} A ${destinatario} — Data: ${new Date().toLocaleDateString('it-IT')}
OGGETTO: Due Diligence Finanziaria — ${d.nome}
AZIENDA: ${d.nome} | ATECO ${d.ateco} | Rating ${d.rating} | Score ${d.rating_score}/100 | Punteggio proprietario ${sc}/100
DATI: ${serie}
ANOMALIE: ${anoms.map(a=>a.msg).join('; ')||'nessuna critica'}
PREVISIONE 12 MESI: ${pred.stato}

Redigi una lettera formale professionale con:
- Intestazione formale
- Oggetto e riferimento
- Sintesi esecutiva (3 righe)
- Analisi struttura finanziaria
- Rischi identificati
- Punti di forza
- Raccomandazione operativa con limite credito preciso, condizioni e clausole
- Firma formale

Italiano formale. Tono da consulente senior. Struttura da lettera aziendale reale.`,

    exec: `Sei il Chief Credit Officer. Redigi un executive summary di due diligence.

Da: ${mittente} | A: ${destinatario} | Data: ${new Date().toLocaleDateString('it-IT')}
AZIENDA: ${d.nome} | Rating ${d.rating} | Punteggio ${sc}/100
DATI: ${serie}
PREVISIONE: ${pred.stato}

Massimo 300 parole. Solo i fatti decisionali: giudizio sintetico, rischio principale, limite credito consigliato, una sola azione raccomandata. Formato: punti numerati. Tono diretto.`,

    credit: `Sei il Chief Credit Officer. Redigi un parere formale sul credito commerciale.

Da: ${mittente} | A: ${destinatario} | Data: ${new Date().toLocaleDateString('it-IT')}
AZIENDA: ${d.nome} | Rating ${d.rating} | Limite CreditSafe €${d.limite_credito.toLocaleString()}
PUNTEGGIO PROPRIETARIO: ${sc}/100
DATI ULTIMO ANNO: Fatturato ${fmtE(a.fatturato)} | EBITDA% ${fmtP(a.ebitda_margin)} | CR ${a.current_ratio.toFixed(2)} | D/E ${fmtP(a.debt_equity)}
ANOMALIE: ${anoms.filter(x=>x.sev==='critical').map(x=>x.msg).join('; ')||'nessuna'}

Redigi il parere di credito con:
- Limite consigliato (importo preciso e motivazione)
- Forma tecnica (pagamento anticipato/posticipato/fido/garanzia bancaria)
- Condizioni (termini, eventuali garanzie richieste)
- Clausole di protezione raccomandate
- Soglie di allerta da monitorare
- Durata validità del parere

Italiano formale. Struttura da documento bancario. Preciso e vincolante.`
  };

  try {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:4000, messages:[{role:'user',content:prompts[reportType]}] })
    });
    const data = await r.json();
    const text = data.content?.[0]?.text || 'Errore.';
    out.innerHTML = text.replace(/\n/g,'<br>');
    document.getElementById('btn-copy').style.display = 'inline-block';
    window._lastReport = text;
  } catch(e) {
    out.innerHTML = '<span style="color:var(--red)">Errore: '+e.message+'</span>';
  }
}

function copyReport() {
  if(window._lastReport) {
    navigator.clipboard.writeText(window._lastReport);
    const btn = document.getElementById('btn-copy');
    btn.textContent = '✓ Copiato';
    setTimeout(() => btn.textContent = '⎘ Copia testo', 2000);
  }
}

// ── FILE CARICAMENTO ──────────────────────────────────────────
function loadJSONFiles(input) {
  const files = Array.from(input.files);
  let loaded = 0;
  files.forEach(file => {
    const reader = new FileReader();
    reader.onload = e => {
      try {
        const d = JSON.parse(e.target.result);
        const r = d.report;
        if(!r) return;
        const extracted = extractFromReport(r);
        if(extracted && !PORTFOLIO.find(x => x.id===extracted.id)) {
          PORTFOLIO.push(extracted);
        }
        loaded++;
        if(loaded===files.length) renderPortafoglio();
      } catch(err) { console.error('Errore parsing JSON:', err); }
    };
    reader.readAsText(file);
  });
}

function extractFromReport(r) {
  const cs = r.companySummary || {};
  const cr = r.creditScore || {};
  const fs = r.financialStatements || [];
  const anni = fs.map(f => {
    const pl = f.profitAndLoss || {}, bs = f.balanceSheet || {}, ra = f.ratios || {};
    const v = (...keys) => { for(const k of keys) { for(const src of [pl,bs,ra]) { const x=src[k]; if(x==null)continue; if(typeof x==='object'){const val=x.value||x.amount; if(val!=null)return parseFloat(val);}try{return parseFloat(x);}catch{} } } return 0; };
    const fat=v('revenue')||1, op=v('operatingProfit'), dep=v('depreciation')+v('amortisation'), ebitda=op+dep, un=v('profitAfterTax');
    return {anno:f.yearEndDate?.slice(0,4)||'',fatturato:v('revenue'),ebitda:Math.round(ebitda),ebitda_margin:Math.round(ebitda/fat*100*100)/100,op_margin:Math.round(op/fat*100*100)/100,net_margin:Math.round(un/fat*100*100)/100,utile_operativo:op,utile_netto:un,salari:v('wagesAndSalaries'),ammortamenti:dep,interessi_passivi:v('financialExpenses'),utile_ante_imposte:v('profitBeforeTax'),imposte:v('tax'),totale_attivo:v('totalAssets'),immobilizzazioni:v('totalFixedAssets'),crediti_clienti:v('tradeReceivables'),rimanenze:v('totalInventories'),liquidita:v('cash','cashAndEquivalents'),patrimonio_netto:v('totalShareholdersEquity','netWorth'),debiti_totali:v('totalLiabilities','totalBorrowings'),debiti_breve:v('currentLiabilities','shortTermDebt'),roi:v('returnOnCapitalEmployed','returnOnAssets'),roe:v('returnOnEquity'),current_ratio:v('currentRatio','liquidityRatio'),debt_equity:v('debtEquityRatio','gearing'),dso:v('debtorDays'),dpo:v('creditorDays')};
  });
  return {id:(cs.companyRegistrationNumber||Math.random().toString(36).slice(2)).replace('/','_'),nome:cs.businessName||'Sconosciuta',settore:cs.mainActivity?.description||'',ateco:cs.mainActivity?.code||'',stato:'Attiva',rating:cr.currentCreditRating?.commonValue||'',rating_desc:cr.currentCreditRating?.commonDescription||'',rating_score:parseInt(cr.currentCreditRating?.providerValue?.value||0),rating_prev:cr.previousCreditRating?.commonDescription||'',limite_credito:parseInt(cr.currentCreditRating?.creditLimit?.value||0),anni};
}

// ── NAVIGAZIONE ───────────────────────────────────────────────
function showView(name) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  const navMap = {portafoglio:0,predittivo:1,stress:2,alert:3,report:4,detail:-1};
  const idx = navMap[name];
  if(idx>=0) document.querySelectorAll('.nav-btn')[idx]?.classList.add('active');

  if(name==='portafoglio') renderPortafoglio();
  if(name==='predittivo') renderPredittivo();
  if(name==='stress') updateStress();
  if(name==='alert') renderAlert();
  if(name==='report') populateReportSelect();
}

// ── INIT ──────────────────────────────────────────────────────
document.getElementById('topbar-date').textContent = new Date().toLocaleDateString('it-IT',{day:'2-digit',month:'long',year:'numeric'});
// Legge ?view= dall'URL per navigazione diretta dall'hub
const _urlParams = new URLSearchParams(window.location.search);
const _initView = _urlParams.get('view') || 'portafoglio';
showView(_initView);
</script>

